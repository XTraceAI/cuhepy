from typing import Any

def create(n: int, shifted_secret: bytes) -> Any: ...
def prepare(owner: Any, modulus_hex: str) -> None: ...
def multiply(owner: Any, coefficients: bytes, modulus_hex: str) -> bytes: ...
def encrypt(owner: Any, a: bytes, message: bytes, entropy: bytes, modulus_hex: str, t: int, eta: int) -> bytes: ...
def decrypt(owner: Any, c0: bytes, c1: bytes, modulus_hex: str, t: int) -> bytes: ...
def close(owner: Any) -> None: ...
